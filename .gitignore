# Secrets
.env
.env.local
*.env.local

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build output
frontend/dist/
native-fork/frontend/dist/
native-fork/backend/uploads/

# Backend runtime data — user uploads, generated assets
backend/uploads/
generated-images/

# Release archives produced by make_release.sh — top-level only.
# website/releases/ holds zips that ship to the public download page
# and IS tracked.
/releases/

# Claude / agent local state
.claude/

# RTF working notes (kept locally, not in repo)
FeaturesReadme.rtf
FixesReadme.rtf

# Test PDFs used for the spell scanner — typically copyrighted sourcebooks.
*.pdf

# Deploy credentials — never commit. See .deploy-env.example for the
# expected format.
.deploy-env

# Android signing — release keystore + the properties file that holds
# its passwords. Lose either of these and you can't push updates to
# the same applicationId on Play Store, so they live ON DISK ONLY and
# need a manual off-machine backup.
android/keystore/
android/keystore.properties
