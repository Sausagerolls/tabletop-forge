# Android release-signing credentials.
#
# Copy this file to `android/keystore.properties` (gitignored) and
# fill in the values for your own keystore. The build script reads
# it via Properties#load() in android/app/build.gradle.kts and only
# attaches the release signingConfig if `storeFile` is set, so a
# fresh clone without this file still builds debug + non-release
# tasks fine.
#
# storeFile path is relative to android/ (where this file lives).

storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=tabletopforge
keyPassword=CHANGE_ME
