<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Mac App Store entitlements for TableTop Forge.

    Mac App Store submission requires the App Sandbox to be on. Each
    capability the app actually needs gets opted-in via one of the
    keys below; everything else is default-deny. Reviewers read this
    file directly, so each entitlement is annotated with WHY we need it.
-->
<plist version="1.0">
<dict>
    <!-- App identity. REQUIRED for App Store: these must match the
         embedded Mac App Store provisioning profile exactly, or App
         Store Connect rejects the upload ("missing/invalid
         application-identifier entitlement"). The value is
         <TeamID>.<bundle-id>; bundle id comes from tauri.conf.json's
         `identifier`. Hardcoded here because manual codesign (unlike
         Xcode) does not synthesise them. -->
    <key>com.apple.application-identifier</key>
    <string>J4UJD4Z33J.studio.giantmushroom.tabletopforge</string>
    <key>com.apple.developer.team-identifier</key>
    <string>J4UJD4Z33J</string>

    <!-- Mandatory for any Mac App Store submission. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound TCP / UDP. Needed because the bundled Node backend
         talks to Open5e's API on first launch (one-time SRD spell +
         monster import) and to the user's chosen AI provider
         (Anthropic / OpenAI / SwarmUI / LM Studio / Ollama) when the
         GM enables AI features. Also needed for the mDNS publish
         (UDP 5353 multicast). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Inbound TCP. The app IS a server — it listens on port 3001
         (or the next free port up to 3010) so the GM's player phones,
         iPads, and the GM's own browser can connect. This is the
         core reason the app exists; reviewer questions about it
         answered in the App Store description's "Self-hosted VTT
         server" section. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- V8 (Node) and PGlite (Postgres → WebAssembly) JIT-compile at
         runtime. allow-jit grants the MAP_JIT path V8 needs; verified
         on macOS 26 to be sufficient on its own — the bundled Node boots
         and PGlite initialises under the sandbox with ONLY this. We
         deliberately do NOT request allow-unsigned-executable-memory:
         V8 doesn't need it here and the Mac App Store rejects it.

         IMPORTANT: cs.allow-jit must ALSO be declared on each nested
         helper (node, apple-intelligence-server) directly — see
         Entitlements.AppStore.Helper.plist. `inherit` does NOT
         propagate hardened-runtime (cs.*) entitlements to spawned
         children; without it on the helper, Node aborts in
         V8::Initialize() with a brk-1 trap. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- disable-library-validation is intentionally OMITTED: every
         bundled executable is signed with this same team ID, so library
         validation passes on its own. Requesting it is an unnecessary
         Mac App Store rejection risk. -->
</dict>
</plist>
