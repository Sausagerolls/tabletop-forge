{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TableTop Forge",
  "version": "1.9.21",
  "identifier": "studio.giantmushroom.tabletopforge",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TableTop Forge",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "url": "loading.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "copyright": "\u00a9 2026 Giant Mushroom Studio",
    "shortDescription": "Self-hosted virtual tabletop for 5e tabletop RPGs",
    "longDescription": "TableTop Forge \u2014 a self-contained desktop build of the VTT. Bundles its own Postgres-compatible database (PGlite) and runs entirely offline; no Docker, no external server, no network round-trip for the basics.",
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../backend/src/**/*",
      "../backend/node_modules/**/*",
      "../backend/package.json",
      "../backend/plugins/elemental-templates/**/*",
      "../backend/plugins/tab-controller/**/*",
      "../frontend/dist/**/*",
      "../init.sql",
      "../sounds/**/*",
      "../default_player.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "macos/Entitlements.AppStore.plist",
      "exceptionDomain": "",
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
